def SliceCodonStr(orf):
    return [orf[i: i+3] for i in range(0, len(orf), 3)]

def calcCAI(orf, w):
    codons = SliceCodonStr(orf)
    
    cai = 0
    ncodon = 0
    for c in codons:
        if c not in w:
            print("Codon count is not defined for {0}, so it is skipped.".format(c),file=sys.stderr)
            continue
        elif w[c] == 0:
            print("Codon count is 0 for {0}, assign -10 to log(0)\n".format(c),file=sys.stderr)
            cai += -10
            ncodon += 1
        else:
            #print(c, w[c])
            cai += math.log(w[c])
            ncodon += 1;
    
    cai /= ncodon
    return math.exp(cai)


def calcDUS(orf: str, dw: dict):
    codons = SliceCodonStr(orf)
    log_dus = 0;
    for i in range(1, len(codons)):
        if(codons[i-1] not in dw or
           codons[i]   not in dw[codons[i-1]]):
            print(f'Dicodon usage of {codons[i-1]}:{codons[i]} pair is not defined.', file=sys.stderr)
            continue
        
        if(dw[codons[i-1]][codons[i]] == 0):
            log_dus = -999
            break
        else:
            log_dus += math.log(dw[codons[i-1]][codons[i]])
    
    log_dus /= len(codons) - 1
    return math.exp(log_dus)


def calcDW(DUC_file: str, pcount: int):
    d = {}
    
    count = {}
    with open(DUC_file, 'r') as fh:
        for line in fh.readlines():
            line = line.strip()
            
            (c1, c2, c, aa1, aa2) = line.split('\t')
            
            if c1 not in count:
                count[c1] = {}
            if c2 not in count[c1]:
                count[c1][c2] = int(c) + pcount
    
    # determine most frequent codon pair for each amino acid
    for c1 in count.keys():
        max_count = 0
        for c2 in count[c1].keys():
            if max_count < count[c1][c2]:
                max_count = count[c1][c2]
            if max_count == 0:
                print(f'Count of codon after {c1} is 0.', file=sys.stderr)
            
            #print(c1, c2, aa1, aa2, max_count)
            for c2 in count[c1].keys():
                if c1 not in d:
                    d[c1] = {}                    
                d[c1][c2] = count[c1][c2]/max_count

    return d


