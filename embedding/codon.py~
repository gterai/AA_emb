def calc_tAI(orf: str, w: dict):
    
    logW = 0
    codons = SliceCodonStr(orf);
    for c in codons:
        if c == 'TAA' or c == 'TGA' or c == 'TAG':
            print(f'Stop codon {c} is skipped.', file=sys.stderr)
            continue
        elif c not in w:
            print(f'Weight for {c} is not defined.', file=sys.stderr)
            exit(0)
        
        logW += math.log(float(w[c]))
    
    logW /= len(codons)

    return math.exp(logW)


def calcENC(orf: str):
    codons = SliceCodonStr(orf)
    codon2aa = set_codon2aa()
    aa2codon = set_aa2codon()
    chkAllAA(orf)
    
    aa2ksyn = {} # 各アミノ酸が何個の同義コドンを持つか
    for aa in aa2codon.keys():
        if(aa == '*'): continue
        n = 0
        for c in aa2codon[aa].keys():
            n += 1
        aa2ksyn[aa] = n 
        #print(aa, aa2ksyn[aa])
        
    naa = {}  # 各アミノ酸の出現数
    nsyn = {} # 各コドンの出現数
    for aa in aa2ksyn.keys(): # 最初に初期化してしまう（perlでは後に初期化）
        naa[aa] = 0
        for c in aa2codon[aa].keys():
            nsyn[c] = 0
    for c in codons: # 出現数をカウント
        aa = codon2aa[c]
        if(aa == '*'): continue
        naa[aa] += 1
        nsyn[c] += 1
    
    ksyn2kaa = {} # 同義コドン数がkのアミノ酸が何種類あるか(ENC独特）
    for aa in aa2ksyn:
        ksyn = aa2ksyn[aa]
        if ksyn not in ksyn2kaa: ksyn2kaa[ksyn] = 0
        ksyn2kaa[ksyn] += 1

    # アミノ酸ごとのF値
    aa2F = {}
    for aa in aa2ksyn.keys():
        if aa2ksyn[aa] == 1: # １種類しかないコドン
            aa2F[aa] = 1
        else:
            sumP2 = 0 
            for c in aa2codon[aa].keys():
                sumP2 += (nsyn[c]/naa[aa]) ** 2
            aa2F[aa] = (naa[aa] * sumP2 - 1)/(naa[aa] - 1);
        
    F = [[] for i in range(6+1)]
    #print(F)
    for aa in aa2ksyn.keys():
        ksyn = aa2ksyn[aa]
        F[ksyn].append(aa2F[aa]) # アミノ酸ごとのF値を、グループ分けして保持する。
    
    enc = 0
    for ksyn in [1,2,3,4,6]:
        meanF = mean(F[ksyn]) # <- meanFが論文で記述されたF値である。
        
        enc += ksyn2kaa[ksyn]/meanF
    
    #exit(0);
    return enc


