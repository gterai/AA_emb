def calcW(cuc_file):
    d = {}
    
    Count = {}
    max = {}
    with open(cuc_file, 'r') as fh:
        for line in fh.readlines():
            line = line.strip()
            
            (aa, codon, count) = line.split('\t')
            if aa not in Count: 
                Count[aa] = {}

            Count[aa][codon] = int(count)
    
    # determine most frequent codon
    max = {}
    for aa in Count.keys():
        max[aa] = 0
        for codon in Count[aa].keys():
            #print(aa,codon)
            c = Count[aa][codon]
            if max[aa] < c: max[aa] = c 

        #print(aa, max[aa])

    # calculate W
    for aa in Count.keys():
        for codon in Count[aa].keys():
            c = Count[aa][codon]
            d[codon] = c/max[aa]
            #print(codon, d[codon])
            
    return d

