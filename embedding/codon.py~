def calcCSCg(orf: str, w: dict):
    codons = SliceCodonStr(orf)

    vals = []
    for c in codons:
        if c == 'TAA' or c == 'TGA' or c == 'TAG':
            print(f'Stop codon {c} is skipped.', file=sys.stderr)
            continue
        elif c not in w:
            print(f'Weight for {c} is not defined.', file=sys.stderr)
            exit(0)
        
        vals.append(w[c])
    
    return mean(vals)


    
